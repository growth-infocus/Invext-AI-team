# ============================================================
# AI Agent Microservices — Environment Variables
# Copy to .env and fill in your keys
# ============================================================

# ─── Infrastructure ──────────────────────────────────────────
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+psycopg2://agentuser:agentpass@postgres:5432/agentdb

# ─── LLM API Keys ────────────────────────────────────────────
# OpenRouter (free tier available — sign up at openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (free tier — sign up at console.groq.com)
GROQ_API_KEY=gsk_REPLACE_ME

# Google Gemini (free tier — get key at aistudio.google.com)
GEMINI_API_KEY=AIza_REPLACE_ME

# HuggingFace (optional fallback — sign up at huggingface.co)
HUGGINGFACE_API_KEY=hf_REPLACE_ME

# ─── LLM Models per Provider ─────────────────────────────────
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GROQ_MODEL=llama3-8b-8192
GEMINI_MODEL=gemini-1.5-flash
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# ─── Per-Agent LLM Provider Routing ─────────────────────────
MANAGER_PROVIDER=openrouter
DEVELOPER_PROVIDER=groq
DEVOPS_PROVIDER=groq
QA_PROVIDER=openrouter
SUPPORT_PROVIDER=gemini
DOCS_PROVIDER=openrouter

# ─── Email Notifications (SMTP) ──────────────────────────────
# Gmail: use App Password (not your real password)
# Settings > Security > 2FA enabled > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-team-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=AI Team <your-team-email@gmail.com>
EMAIL_TO=manager@yourcompany.com

# ─── Web Search (Serper.dev) ─────────────────────────────────
# Free tier: 2,500 searches/month — sign up at serper.dev
SERPER_API_KEY=REPLACE_ME

# ─── Agent Scheduler Settings ────────────────────────────────
# Cron: daily plan at 09:00, delegation loop every 30min, report at 17:00
SCHEDULER_ENABLED=true
DAILY_PLAN_CRON=0 9 * * *
DELEGATION_INTERVAL_MINUTES=30
DAILY_REPORT_CRON=0 17 * * *
WEEKLY_REPORT_CRON=0 8 * * 1

# ─── Security ────────────────────────────────────────────────
# Random 32-char hex: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# ─── Graphiti / Neo4j (optional) ─────────────────────────────
# Leave blank or set USE_GRAPHITI_MEMORY=false to use Redis memory
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
USE_GRAPHITI_MEMORY=false

# ─── Obsidian Export ─────────────────────────────────────────
# Path to export agent memories as Obsidian vault
OBSIDIAN_VAULT_PATH=./obsidian_vault

# ─── Sandbox Limits ──────────────────────────────────────────
SANDBOX_DIR=/app/sandbox
SANDBOX_TIMEOUT_SECONDS=30
REPORTS_DIR=/app/reports

# ─── Microsoft Teams Integration ─────────────────────────────────────────────
# Incoming Webhook URL from Teams channel connector
# In Teams: Channel → ··· → Connectors → Incoming Webhook → Configure
TEAMS_WEBHOOK_URL=https://yourcompany.webhook.office.com/webhookb2/...
MEETING_CHANNEL=Engineering Team

# ─── Jira MCP Integration (OPTIONAL) ─────────────────────────────────────────
# By default the system uses its own built-in ticket tracker (Postgres backed).
# To ALSO sync with Jira, set JIRA_MCP_ENABLED=true and configure the MCP server.
#
# MCP Server: https://github.com/sooperset/mcp-atlassian
# Install:    pip install mcp-atlassian
# Run:        mcp-atlassian --host 0.0.0.0 --port 8020
#
# When enabled, create_ticket calls will route through Jira instead of local DB.
JIRA_MCP_ENABLED=false
JIRA_MCP_URL=http://localhost:8020
JIRA_PROJECT_KEY=PROD
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=your-email@company.com
JIRA_API_TOKEN=REPLACE_ME

# ─── Per-Agent LLM Provider Routing (new specialist agents) ──────────────────
DESIGN_PROVIDER=openrouter
UX_PROVIDER=openrouter
UI_TEST_PROVIDER=openrouter
API_TEST_PROVIDER=groq
QA_AUTO_PROVIDER=groq
SECURITY_PROVIDER=openrouter

# ─── DevOps Management ────────────────────────────────────────────────────────
# Notification settings for deployment events
DEPLOY_NOTIFICATION_ENABLED=true
# Git integration (optional — for auto-detecting commits on push)
GITHUB_WEBHOOK_SECRET=REPLACE_ME
GITHUB_REPO=your-org/your-repo
